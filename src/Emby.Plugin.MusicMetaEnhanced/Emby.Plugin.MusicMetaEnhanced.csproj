<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Emby.Plugin.MusicMetaEnhanced</RootNamespace>
    <AssemblyName>Emby.Plugin.MusicMetaEnhanced</AssemblyName>
    <!-- Version is derived from git tags by MinVer (see below):
         tag v1.5.10 -> 1.5.10.0. No version is hardcoded here. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Emby 4.9.5.0 runs on .NET 8. Point EmbySystemDir (or the EMBY_SYSTEM_DIR
         environment variable) at your Emby server's "system" directory. -->
    <EmbySystemDir Condition="'$(EmbySystemDir)' == ''">$(EMBY_SYSTEM_DIR)</EmbySystemDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Derives the version from the closest git tag. Needs git + full history
         (CI must check out with fetch-depth: 0). -->
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
    <!-- ExcludeAssets=runtime: reference it to compile, but never copy it next to
         the plugin (Emby loads its own copy). -->
    <PackageReference Include="System.IO.Pipelines" Version="8.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dashboard configuration page, served from inside the DLL. -->
    <EmbeddedResource Include="Configuration/configPage.html" />
    <!-- Plugin thumb image, shown on the dashboard Plugins page (IHasThumbImage). -->
    <EmbeddedResource Include="Configuration/plugin.jpg" />
  </ItemGroup>

  <ItemGroup>
    <!-- Emby server assemblies. Private=false: never copy them next to the plugin. -->
    <Reference Include="MediaBrowser.Common">
      <HintPath>$(EmbySystemDir)\MediaBrowser.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>$(EmbySystemDir)\MediaBrowser.Controller.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Model">
      <HintPath>$(EmbySystemDir)\MediaBrowser.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Required by MediaBrowser.Model.Services.IResponse.OutputWriter (PipeWriter).
         Not shipped by the portable Emby package, so it comes from NuGet —
         compile-time only, Emby provides it at runtime. -->
  </ItemGroup>

  <!-- MinVer intentionally zeroes AssemblyVersion to "{major}.0.0.0" so that
       assembly binding stays stable. Emby, however, shows the assembly version
       on the Plugins page, which would make every release read "1.0.0.0".
       Restore the full version so the dashboard reports e.g. 1.5.10.0. -->
  <Target Name="MinVerFullAssemblyVersion"
          AfterTargets="MinVer"
          BeforeTargets="GetAssemblyVersion"
          Condition="'$(MinVerMajor)' != ''">
    <PropertyGroup>
      <AssemblyVersion>$(MinVerMajor).$(MinVerMinor).$(MinVerPatch).0</AssemblyVersion>
    </PropertyGroup>
  </Target>

</Project>
